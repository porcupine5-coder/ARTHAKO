# API .env.example
# Copy this file to `api/.env` for local development and fill with real values.
# DO NOT commit real `.env` files containing sensitive credentials.

# Supabase (server-side)
# Your Supabase project URL (found in Supabase dashboard → Settings → API)
SUPABASE_URL=

# Supabase Service Role key (found in Supabase dashboard → Settings → API)
# THIS IS A SENSITIVE SERVER-ONLY KEY. Never expose this to the frontend or commit it.
SUPABASE_KEY=

# Supabase Anon key (public, safe to expose to frontend)
# Used for read-only operations and user-scoped queries with RLS
SUPABASE_ANON_KEY=

# Server configuration
# Port the API server should listen on (default used by scripts is 8082)
PORT=8082

# Node environment
NODE_ENV=development

# Security Configuration (Optional)
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://app.yourdomain.com
# If not set, defaults to localhost origins only (http://localhost:5173,http://localhost:3000)
ALLOWED_ORIGINS=

# Database Connection Pooling (Optional)
# Supabase connection pooler URL for production (found in Supabase dashboard → Database → Connection Pooling)
# Use this instead of direct connection for better performance and connection management
# Example: postgresql://postgres.xxxxx.supabase.co:6543/postgres?pgbouncer=true
SUPABASE_POOLER_URL=

# Connection pool limits (optional, defaults: min=2, max=10)
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT secret used to verify Supabase-issued JWT tokens (server-only)
# Get this from Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
# This is sensitive and must never be committed.
SUPABASE_JWT_SECRET=

# Security notes:
# - SUPABASE_KEY is a service role / admin key and must remain secret.
# - For production, use your deployment platform's secret management.
# - If a key is exposed, rotate and revoke it immediately. See SECURITY_ENV_SETUP.md
# - Enable Row Level Security (RLS) on all user-scoped tables in Supabase dashboard
# - Use service role key (SUPABASE_KEY) only for admin operations and data updates
# - Use anon key (SUPABASE_ANON_KEY) for read-only public data queries
# - Configure connection pooling for production deployments
# - See SECURITY_DATABASE.md for detailed setup instructions
