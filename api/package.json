{
  "name": "nepse-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "update-data": "tsx src/updateData.ts",
    "scheduler": "tsx src/scheduler.ts",
    "db:migrate": "psql $SUPABASE_POOLER_URL -f ../db/schema.sql",
    "db:verify-rls": "tsx src/scripts/verifyRLS.ts",
    "db:test-queries": "tsx src/scripts/testQueries.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.46.1",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "pg": "8.11.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "20.11.30",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "4.19.1",
    "typescript": "5.4.5"
  }
}
